# TestDock 配置示例（不含任何凭证 / 令牌 / 连接串秘密）
# 复制为 .env 后按需修改；正式初始化不灌演示数据。
# 所有路径可基于安装目录解析，不依赖开发者个人目录。

# ---- 服务绑定与端口（dev_up.ps1、vite.config.ts、健康检查、停止共用） ----
TESTDOCK_HOST=127.0.0.1
TESTDOCK_PORT=8000
# 兼容别名：dev_up.ps1 会把同一值同时写给 Vite 代理
TESTDOCK_API_PORT=8000
TESTDOCK_WEB_HOST=127.0.0.1
TESTDOCK_WEB_PORT=5173

# ---- 目录与工具（可含空格；Windows 用反斜杠或正斜杠均可） ----
# TESTDOCK_DATA_DIR=D:\TestDock Data\data
# TESTDOCK_RUNTIME_DIR=D:\TestDock Data\runtime
# TESTDOCK_ADB=D:\TestDock Data\vendor\mobile_auto\tools\adb\adb.exe
# TESTDOCK_RUNNER_PYTHON=D:\Python 3.12\python.exe
# TESTDOCK_PYTHON=D:\Python 3.12\python.exe

# ---- 可信来源（宿主配置，不接受浏览器任意路径） ----
# TESTDOCK_SUITE_SOURCES 是 JSON 数组：[{"id":"ui-main","path":"D:\\TestDock Sources\\mobile-auto","type":"ui"}]
# TESTDOCK_SUITE_SOURCES=[{"id":"ui-main","path":"D:\\TestDock Sources\\mobile-auto","type":"ui"}]

# ---- 演示环境：必须另配独立数据库与产物目录 ----
# TESTDOCK_DEMO_MODE=1
# TESTDOCK_FAKE_RUNNER=1
# TESTDOCK_DATABASE_URL=postgresql+psycopg://testdock@127.0.0.1:55433/testdock_demo
# TESTDOCK_DATA_DIR=D:\TestDock Demo\data

# ---- 开发者 vendor 同步（仅 `python scripts/vendor_sync.py sync` 需要） ----
# TESTDOCK_MOBILE_AUTO_SOURCE=D:\sources\mobile-auto
# TESTDOCK_MOBILE_PERF_SOURCE=D:\sources\mobile-perf

# 构建可提供提交标识时展示，否则关于页明确说明不可用
# TESTDOCK_BUILD_COMMIT=abcdef123456
